# Copy to .env and fill in. See agents/common/model.py and docs/plan.md.

# "google" (default, AI Studio) or "openai" (any ChatGPT-API-compatible endpoint via LiteLLM).
MODEL_PROVIDER=google

# Required when MODEL_PROVIDER=google. Get one at https://aistudio.google.com/apikey
# Also required for corpus retrieval regardless of MODEL_PROVIDER: embeddings always
# go through Gemini (see agents/rfp_agent/tools/retrieval.py).
GOOGLE_API_KEY=

# Optional, defaults to gemini-2.5-flash.
# GOOGLE_MODEL=gemini-2.5-flash

# Optional, defaults to gemini-embedding-001. Used for corpus retrieval only.
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Required when MODEL_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Optional, unset by default. Some reasoning models reject function tools on
# the chat completions endpoint unless reasoning is turned off; set to
# "none" if you hit that error. Otherwise leave unset.
# OPENAI_REASONING_EFFORT=
